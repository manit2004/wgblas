# Python and Node.js dependencies
node_modules/
.venv/
__pycache__/
*.pyc

# benchmark binaries — non-migrated cuda dirs still build "benchmark" flat;
# migrated ones (e.g. saxpy) build into cuda/bin/ instead
benchmarks/*/cuda/benchmark
benchmarks/*/cuda/bin/

# Kaggle API credentials
kaggle.json

# npm publish bundle (generated by build:browser)
dist/

# local secrets
.env

# coverage reports
coverage/

#jscpd reports
jscpd/
# wgblas-docs-mcp package: copied in at pack time (see mcp/package.json), plus npm pack output
mcp/api.json
mcp/LICENSE
mcp/*.tgz
