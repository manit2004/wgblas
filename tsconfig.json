{
  "include": ["index.d.mts", "src/**/*.d.mts"],
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    // TS 6.x bundles GPUDevice/GPUBuffer/etc. natively, so this is a no-op
    // there — but an older tsc (e.g. a global install a bare `tsc` picks up
    // instead of `npx tsc`) has no native WebGPU types and needs it spelled
    // out. @webgpu/types itself needs "DOM" too (GPUDevice extends EventTarget).
    "types": ["@webgpu/types"],
    // TS 6.x's native GPU* declarations collide with @webgpu/types' own
    // (TS2403/TS6200). skipLibCheck only skips third-party .d.ts files, not
    // this project's own — those still get fully checked.
    "skipLibCheck": true,
    "paths": {
      "wgblas": ["./index.d.mts"],
      "wgblas/classes/GpuVector": ["./src/classes/GpuVector.d.mts"],
      "wgblas/classes/GpuMatrix": ["./src/classes/GpuMatrix.d.mts"],
      "wgblas/classes/Complex32": ["./src/classes/Complex32.d.mts"],
      "wgblas/classes/Complex64": ["./src/classes/Complex64.d.mts"],
      "wgblas/random": ["./src/random/random.d.mts"],
      "wgblas/sscal": ["./src/sscal/sscal.d.mts"],
      "wgblas/cscal": ["./src/cscal/cscal.d.mts"],
      "wgblas/dscal": ["./src/dscal/dscal.d.mts"],
      "wgblas/sswap": ["./src/sswap/sswap.d.mts"],
      "wgblas/saxpy": ["./src/saxpy/saxpy.d.mts"],
      "wgblas/daxpy": ["./src/daxpy/daxpy.d.mts"],
      "wgblas/scopy": ["./src/scopy/scopy.d.mts"],
      "wgblas/sdot": ["./src/sdot/sdot.d.mts"],
      "wgblas/sasum": ["./src/sasum/sasum.d.mts"],
      "wgblas/dasum": ["./src/dasum/dasum.d.mts"],
      "wgblas/ddot": ["./src/ddot/ddot.d.mts"],
      "wgblas/snrm2": ["./src/snrm2/snrm2.d.mts"],
      "wgblas/isamax": ["./src/isamax/isamax.d.mts"],
      "wgblas/idamax": ["./src/idamax/idamax.d.mts"],
      "wgblas/srot": ["./src/srot/srot.d.mts"],
      "wgblas/srotm": ["./src/srotm/srotm.d.mts"],
      "wgblas/sgemv": ["./src/sgemv/sgemv.d.mts"],
      "wgblas/ssymv": ["./src/ssymv/ssymv.d.mts"],
      "wgblas/strmv": ["./src/strmv/strmv.d.mts"],
      "wgblas/strsv": ["./src/strsv/strsv.d.mts"],
      "wgblas/sger": ["./src/sger/sger.d.mts"],
      "wgblas/ssyr": ["./src/ssyr/ssyr.d.mts"],
      "wgblas/ssyr2": ["./src/ssyr2/ssyr2.d.mts"],
      "wgblas/sgemm": ["./src/sgemm/sgemm.d.mts"],
      "wgblas/sgemmtr": ["./src/sgemmtr/sgemmtr.d.mts"],
      "wgblas/ssyrk": ["./src/ssyrk/ssyrk.d.mts"],
      "wgblas/ssyr2k": ["./src/ssyr2k/ssyr2k.d.mts"],
      "wgblas/ssymm": ["./src/ssymm/ssymm.d.mts"],
      "wgblas/strmm": ["./src/strmm/strmm.d.mts"],
      "wgblas/strsm": ["./src/strsm/strsm.d.mts"]
    }
  }
}
