  "sgemm": {
    "level": 3,
    "note": "internally dispatches sgemm_small or sgemm_large depending on a tile-size threshold -- worth a dense sweep right around that crossover",
    "parameters": [
      { "name": "transA", "role": "flag", "values": ["no-transpose", "transpose"] },
      { "name": "transB", "role": "flag", "values": ["no-transpose", "transpose"], "description": "dominates transA's effect on this codebase's kernels (+22-57% at n=1024) -- see sgemm.mjs benchmark notes" },
      { "name": "m", "role": "size" },
      { "name": "n", "role": "size" },
      { "name": "k", "role": "size", "description": "drives inner reduction/tile-iteration count, distinct role from m/n -- currently only swept as m=n=k" },
      { "name": "alpha", "role": "scalar" },
      { "name": "A", "role": "data" },
      { "name": "lda", "role": "leading-dimension", "description": "scoped and found to be a non-effect -- see sgemm.mjs benchmark notes" },
      { "name": "B", "role": "data" },
      { "name": "ldb", "role": "leading-dimension", "description": "matters only when transB = transpose -- see sgemm.mjs benchmark notes" },
      { "name": "beta", "role": "scalar" },
      { "name": "C", "role": "data" },
      { "name": "ldc", "role": "leading-dimension", "description": "scoped and found to be a non-effect -- see sgemm.mjs benchmark notes" },
      { "name": "layout", "role": "layout", "values": ["row-major", "col-major"], "default": "row-major" }
    ]
  },
