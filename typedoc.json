{
  "entryPoints": [
    "index.d.mts",
    "src/devdocs.mjs",
    "src/index.mjs",
    "src/shaders/index.mjs",
    "src/util/*.mjs",
    "tests/index.mjs",
    "tests/helpers/ulp.js",
    "tests/helpers/fixtures.js",
    "tests/helpers/validation.js",
    "tests/validation/index.mjs",
    "tests/routines/index.mjs",
    "tests/routines/helpers.mjs",
    "examples/index.mjs",
    "examples/assets/index.mjs",
    "examples/scripts/index.mjs"
  ],
  "entryPointStrategy": "expand",
  "tsconfig": "tsconfig.typedoc.json",
  "out": "docs",
"navigation": {
    "includeCategories": true,
    "includeGroups": false
  },
  "customJs": "assets/docs/runner.js",
  "projectDocuments": ["assets/bench-result/**/*.md"],
  "sourceLinkTemplate": "https://github.com/manit2004/wgblas/blob/main/{path}#L{line}"
}
