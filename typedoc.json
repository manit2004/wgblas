{
  "entryPoints": [
    "index.d.mts",
    "src/devdocs.mjs",
    "src/index.mjs",
    "src/shaders/index.mjs",
    "src/tests/index.mjs",
    "src/util/*.mjs"
  ],
  "entryPointStrategy": "expand",
  "tsconfig": "tsconfig.typedoc.json",
  "out": "docs",
"navigation": {
    "includeCategories": true,
    "includeGroups": false
  },
  "customJs": "assets/docs/runner.js",
  "projectDocuments": ["assets/bench-result/**/*.md"],
  "sourceLinkTemplate": "https://github.com/manit2004/wgblas/blob/main/{path}#L{line}"
}
